<%@ page pageEncoding="UTF-8" %>
<%-- 경력·학력 카드 한 줄: 지원자 값 · 관계 기호 · 공고 요구. ln(CompareLine)과 lnTitle을 c:set 해 두고 include --%>
<div class="cmp ${empty ln.met ? '' : (ln.met ? 'is-met' : 'is-unmet')}">
  <div class="cmp-side"<c:if test="${not empty lnTitle}"> title="<c:out value='${lnTitle}'/>"</c:if>>
    <strong><c:out value="${ln.value}"/></strong>
    <small><c:out value="${ln.valueCaption}"/></small>
  </div>
  <span class="cmp-sign">${empty ln.sign ? '' : ln.sign}</span>
  <div class="cmp-side is-req">
    <strong><c:out value="${empty ln.required ? '조건 없음' : ln.required}"/></strong>
    <small><c:out value="${ln.requiredCaption}"/></small>
  </div>
  <c:if test="${not empty ln.note}"><p class="cmp-note"><c:out value="${ln.note}"/></p></c:if>
</div>
