<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><c:out value="${pageTitle}"/></title>
  <link rel="icon" type="image/svg+xml" href="<c:url value='/logo.svg'/>?v=${applicationScope.assetVersion}">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@700&display=swap">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css">
  <link rel="stylesheet" href="<c:url value='/css/app.css'/>?v=${applicationScope.assetVersion}">
  <%-- 상단 탭을 눌러 왔을 때만 밑줄이 옛 탭에서 새 탭으로 미끄러진다. 다른 이동은 전환 없이 그대로 --%>
  <script>
    addEventListener('pagereveal', function (e) {
      var tab = false;
      try { tab = sessionStorage.getItem('tabNav') === '1'; sessionStorage.removeItem('tabNav'); } catch (err) { /* 전환만 빠진다 */ }
      if (e.viewTransition && !tab) e.viewTransition.skipTransition();
    });
    addEventListener('pageswap', function (e) {
      var tab = false;
      try { tab = sessionStorage.getItem('tabNav') === '1'; } catch (err) { /* 무시 */ }
      if (e.viewTransition && !tab) e.viewTransition.skipTransition();
    });
  </script>
</head>
<body>
<%@ include file="/WEB-INF/views/common/icons.jspf" %>
<header class="topbar">
  <nav class="tabs topbar-in">
    <a class="brand" href="<c:url value='/templates'/>">Interviewer</a>
    <a class="tab ${activeTab == 'templates' ? 'active' : ''}" href="<c:url value='/templates'/>"><span>공통 질문 설정</span><i class="tab-ink"></i></a>
    <a class="tab ${activeTab == 'positions' ? 'active' : ''}" href="<c:url value='/positions'/>"><span>평가 기준 추출</span><i class="tab-ink"></i></a>
    <a class="tab ${activeTab == 'fit' ? 'active' : ''}" href="<c:url value='/fit'/>"><span>포지션 적합도 검사</span><i class="tab-ink"></i></a>
    <a class="tab ${activeTab == 'ranking' ? 'active' : ''}" href="<c:url value='/ranking'/>"><span>지원자 비교</span><i class="tab-ink"></i></a>
    <a class="tab tab-end ${activeTab == 'settings' ? 'active' : ''}" href="<c:url value='/settings'/>" title="설정" aria-label="설정"><span class="tab-icon"><svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="12" r="3" fill="none" stroke="currentColor" stroke-width="1.7"/></svg></span><i class="tab-ink"></i></a>
  </nav>
</header>
<main class="page">
<c:if test="${not empty message}">
  <div class="flash flash-ok"><c:out value="${message}"/></div>
</c:if>
<c:if test="${not empty error}">
  <div class="flash flash-error"><c:out value="${error}"/></div>
</c:if>
