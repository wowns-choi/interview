<%@ page pageEncoding="UTF-8" %>
<%-- 지원자 고르기의 항목: 이름, 진행 중·실패면 상태 표시 (data-mark, 새 목록 스타일에서만 보인다) --%>
<c:if test="${empty r}"><option value="" disabled selected>지원자 선택</option></c:if>
<c:forEach var="row" items="${candidates}">
  <c:choose>
    <c:when test="${row.inProgress}"><c:set var="tail" value="${row.statusLabel}"/></c:when>
    <c:when test="${row.state == 'RANKED' or row.state == 'EXCLUDED'}"><c:set var="tail" value="${row.score.totalText} / ${row.score.max}"/></c:when>
    <c:when test="${row.state == 'STALE'}"><c:set var="tail" value="재검사 필요"/></c:when>
    <c:when test="${row.status == 'FAILED'}"><c:set var="tail" value="실패"/></c:when>
    <c:otherwise><c:set var="tail" value="${row.statusLabel}"/></c:otherwise>
  </c:choose>
  <option value="<c:url value='/results/${row.candidateId}'/>" data-in-progress="${row.inProgress}" data-tail="${tail}" data-name="<c:out value='${row.displayName}'/>" data-at="${row.createdText}"${row.inProgress ? ' data-mark="'.concat(row.statusLabel).concat('" data-mark-kind="progress"') : row.status == 'FAILED' ? ' data-mark="실패" data-mark-kind="failed"' : row.status == 'UPLOADED' ? ' data-mark="확인 대기" data-mark-kind="wait"' : ''}
          ${not empty r and r.candidate.id == row.candidateId ? 'selected' : ''}><c:out value="${row.displayName}"/> · ${row.createdText}</option>
</c:forEach>
