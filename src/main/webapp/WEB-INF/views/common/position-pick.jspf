<%@ page pageEncoding="UTF-8" %>
<%-- 포지션 고르기 (만들기는 평가 기준 추출 탭에서만). pickBase: 고르면 갈 주소.
     적합도 검사에서는 그 오른쪽에 지원자 고르기, 바로 옆에 지원자 추가 버튼 --%>
<c:set var="onFit" value="${pickBase == '/fit'}"/>
<div class="pick pick-row">
  <label class="pick-select">
    <span>포지션</span>
    <select data-nav>
      <c:forEach var="p" items="${positions}">
        <option value="<c:url value='${pickBase}?position=${p.id}'/>" ${p.id == position.id ? 'selected' : ''}><c:out value="${p.title}"/></option>
      </c:forEach>
    </select>
  </label>
  <c:if test="${onFit}">
  <c:set var="newHref"><c:url value='/fit?position=${position.id}'/></c:set>
  <div class="pick-cand-wrap">
  <c:if test="${not empty candidates}">
  <label class="pick-select pick-cand">
    <c:set var="busyCount" value="${0}"/><c:forEach var="row" items="${candidates}"><c:if test="${row.inProgress}"><c:set var="busyCount" value="${busyCount + 1}"/></c:if></c:forEach>
    <span>지원자 ${fn:length(candidates)}명<em class="pick-busy"${busyCount == 0 ? ' hidden' : ''}> · ${busyCount}명 진행 중</em></span>
    <select data-nav id="cand-list" data-url="<c:url value='/positions/${position.id}/candidates'/>"
            data-current="${empty r ? '' : r.candidate.id}" data-current-status="${empty r ? '' : r.candidate.status}">
      <%@ include file="cand-options.jspf" %>
    </select>
  </label>
  </c:if>
  <a class="pick-new${empty r ? ' is-active' : ''}" href="${newHref}"><svg class="i"><use href="#i-plus"/></svg>${empty candidates ? '지원자 추가' : '추가'}</a>
  </div>
  </c:if>
  <%-- 지원자 비교: 평가 기준 번호표. 표의 번호에 마우스를 올리면 여기 그 줄도 강조된다 (사용자 2026-10-27) --%>
  <c:if test="${pickBase == '/ranking' and not empty criteria}">
  <ol class="pick-crits" id="rk-key">
    <c:forEach var="c" items="${criteria}" varStatus="cs"><li><b>${cs.count}</b><span><c:out value="${c.name}"/></span></li></c:forEach>
  </ol>
  </c:if>
  <%-- 보고서: 고른 지원자의 것이라 고르기 줄 오른쪽 끝 (사용자 2026-10-27). 누를 때마다 묻지 않고 지금 기록에 맞춘다 --%>
  <c:if test="${onFit and not empty r}">
  <form class="iv-report" id="iv-report" method="post" action="<c:url value='/results/${r.candidate.id}/report'/>"
        data-busy="${hasReport ? '보고서를 맞추는 중' : '보고서를 만드는 중'}">
    <button type="submit" class="btn btn-primary"><svg class="i"><use href="#i-file"/></svg>보고서</button>
  </form>
  </c:if>
  <%-- 지원자 올리는 화면: 보고서 자리에 개인정보 엄격 보호 모드 스위치 (사용자 2026-10-28) --%>
  <c:if test="${onFit and empty r and not empty position}">
  <form class="pick-strict" method="post" action="<c:url value='/settings/privacy'/>">
    <input type="hidden" name="back" value="/fit?position=${position.id}">
    <label class="switch"><input type="checkbox" name="strict" value="true" ${strictPrivacy ? 'checked' : ''} onchange="this.form.requestSubmit()"><span class="switch-track"></span>개인정보 엄격 보호 모드</label>
  </form>
  </c:if>
</div>
<%-- 적합도 검사에서 아래로 내리면 포지션과 지원자를 위에 붙여 둔다 --%>
<c:if test="${onFit}">
<div class="pick-bar" id="pick-bar" hidden>
  <div class="pick-bar-in">
    <select class="pick-bar-select" data-nav aria-label="포지션">
      <c:forEach var="p" items="${positions}">
        <option value="<c:url value='${pickBase}?position=${p.id}'/>" ${p.id == position.id ? 'selected' : ''}><c:out value="${p.title}"/></option>
      </c:forEach>
    </select>
    <c:if test="${not empty candidates}">
    <select class="pick-bar-select" data-nav data-cand-copy aria-label="지원자">
      <%@ include file="cand-options.jspf" %>
    </select>
    </c:if>
    <a class="pick-bar-new" href="${newHref}" title="지원자 추가" aria-label="지원자 추가"><svg class="i"><use href="#i-plus"/></svg></a>
    <c:if test="${not empty r}">
    <form class="pick-bar-report" method="post" action="<c:url value='/results/${r.candidate.id}/report'/>"
          data-busy="${hasReport ? '보고서를 맞추는 중' : '보고서를 만드는 중'}">
      <button type="submit" class="btn btn-primary btn-sm"><svg class="i"><use href="#i-file"/></svg>보고서</button>
    </form>
    </c:if>
  </div>
</div>
</c:if>
