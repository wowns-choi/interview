<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.interview.mapper.AppSettingMapper">

    <select id="find" resultType="string">
        SELECT setting_value FROM app_setting WHERE setting_key = #{key}
    </select>

    <update id="update">
        UPDATE app_setting SET setting_value = #{value} WHERE setting_key = #{key}
    </update>

    <insert id="insert">
        INSERT INTO app_setting (setting_key, setting_value) VALUES (#{key}, #{value})
    </insert>
</mapper>
